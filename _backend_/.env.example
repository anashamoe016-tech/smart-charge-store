# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to GitHub.

MONGO_URI=your_mongodb_connection_string_here

PORT=5000

JWT_SECRET=replace_with_a_long_random_secret

STORE_NAME=Smart Charge Store

PRIVATE_API_KEY=replace_with_a_long_random_key

AUTO_ORDERS=false

AUTO_DEPOSIT=false

# Comma-separated list of allowed frontend domains (your storefront/admin domains)
CORS_ORIGIN=https://yourdomain.com

# --- Provider integrations ---
SYRISTORE_BASE_URL=https://api.syristore.com
SYRISTORE_API_TOKEN=

WOLFSTORE_BASE_URL=https://api.wolfstore.com
WOLFSTORE_API_TOKEN=

# --- SyriaMarket API (placeholder, ready for future integration) ---
SYRIAMARKET_BASE_URL=
SYRIAMARKET_API_TOKEN=
