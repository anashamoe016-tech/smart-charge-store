# Copy to .env locally. NEVER commit .env to GitHub.

MONGO_URI=your_mongodb_connection_string_here
PORT=5000
JWT_SECRET=replace_with_a_long_random_secret
STORE_NAME=Smart Charge Store

# CORS: comma-separated frontend origins
CORS_ORIGIN=https://YOUR-GITHUB-USERNAME.github.io,https://your-custom-domain.example

# Worker switches (central DB settings can override these)
AUTO_ORDERS=false
AUTO_DEPOSIT=false

# Google Identity Services
GOOGLE_CLIENT_ID=

# Provider secrets remain here only
SYRIAMARKET_BASE_URL=
SYRIAMARKET_API_TOKEN=

SYRIASTORE_BASE_URL=
SYRIASTORE_API_TOKEN=

WOLFSTORE_BASE_URL=
WOLFSTORE_API_TOKEN=

# Optional private integration secret
PRIVATE_API_KEY=
